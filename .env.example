# ---- App ----
APP_ENV=development
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/analyzer

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# ---- GitHub ----
# Personal access token (no special scopes needed for public data), raises rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Analysis limits ----
MAX_REPOS_ANALYZED=30

# ---- Repo Chat (chat with a GitHub repository) ----
# Model used for chat answers, follow-up condensing and repo overviews
CHAT_MODEL=gpt-4o-mini
# Embedding model + truncated dimensionality (512 keeps vectors small in Postgres JSON)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=64

# Ingestion budget — guards against pathologically large repos
INGEST_MAX_FILES=400
INGEST_MAX_FILE_BYTES=120000
INGEST_MAX_TOTAL_BYTES=8000000
INGEST_MAX_CHUNKS=1500
CHUNK_TARGET_LINES=60
CHUNK_OVERLAP_LINES=12

# Retrieval tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_VECTOR_WEIGHT=0.7
CHAT_HISTORY_TURNS=6
REPO_CHAT_CACHE_TTL_SECONDS=86400


# ---- Accuracy controls (job match) ----
# Extraction feeds the deterministic scorer, so errors here corrupt every score
# downstream. Narration only writes prose. If you upgrade one model, upgrade
# EXTRACTION_MODEL. Both fall back to MATCH_MODEL when unset.
EXTRACTION_MODEL=
NARRATION_MODEL=

# Cross-check extracted skills against the source text and discard any that
# aren't there. No extra API call. Turn this off only if you have a reason.
VERIFY_EXTRACTION=true

# Resume parse caching, keyed by content hash. 0 = disabled (default), which
# keeps personal data out of Redis. Accuracy is identical either way.
RESUME_CACHE_TTL_SECONDS=0

INTERVIEW_QUESTION_COUNT=12
